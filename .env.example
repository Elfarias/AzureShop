# App Service/container runtime port. Keep aligned with the App Service port setting.
PORT=3000
APP_ENV=development
# Use sqlite for local development; use sqlserver for Azure SQL in production.
DB_PROVIDER=sqlite
SQLITE_PATH=./data/loja.db
# Para Azure SQL, use DB_PROVIDER=sqlserver e configure:
# AZURE_SQL_SERVER=servidor.database.windows.net
# AZURE_SQL_DATABASE=imersao
# AZURE_SQL_USER=usuario
# AZURE_SQL_PASSWORD=senha
# Em produção, prefira identidade gerenciada: AZURE_SQL_AUTH=managedIdentity
# Configure the App Service Health Check path as /api/health.
AI_ENABLED=false
# AZURE_OPENAI_ENDPOINT=https://seu-recurso.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
